const { NxAppWebpackPlugin } = require('@nx/webpack/app-plugin');

module.exports = {
  output: {
    // Forge loads function handlers from the exports of index.js, so the
    // bundle must assign the entry module's exports to `module.exports`.
    library: { type: 'commonjs2' },
    filename: 'index.js',
  },
  // The Forge runtime does not set NODE_ENV, so the bundle takes the value that
  // Nx sets for the build configuration. Nx sets the Webpack mode to 'none' for
  // Node apps, so `mode` does not set it.
  optimization: { nodeEnv: process.env.NODE_ENV },
  plugins: [
    new NxAppWebpackPlugin({
      target: 'node',
      compiler: 'tsc',
      outputPath: '<%= offset %><%= webpackPluginOptions.outputPath %>',
      main: '<%= webpackPluginOptions.main %>',
      outputFileName: 'index.js',
      tsConfig: '<%= webpackPluginOptions.tsConfig %>',
      assets: <%- JSON.stringify(webpackPluginOptions.assets) %>,
      // Forge ships the bundle as it is, so it must include all dependencies
      // except Node built-ins.
      externalDependencies: 'none',
      sourceMap: true,
      optimization: false,
      outputHashing: 'none',
      // Do not delete all the files in the output path. This is required to maintain the
      // manifest.yml in the output path when running the tunnel executor. By default,
      // Webpack still cleans the bundle folder in the output directory (dist/apps/<my-app>/functions)
      // but not the project root (refer to Webpack option `output.clean`).
      deleteOutputPath: false,
    }),
  ],
};
